# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHAT_ID=

# AI and market data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TWELVE_DATA_API_KEY=

# Deriv
DERIV_APP_ID=
DERIV_DEMO_TOKEN=
DERIV_REAL_TOKEN=
DERIV_CURRENCY=USD

# Trading controls: select DEMO/LIVE from Telegram; live still requires a real Deriv token and confirmation
AUTO_TRADE=true
ENABLE_LIVE_TRADING=true
DEFAULT_MODE=demo

# Risk and schedule
DEFAULT_EXPIRY_MINUTES=5
SIGNAL_INTERVAL_SECONDS=300
MIN_CONFIDENCE=75
BASE_STAKE=1
MAX_STAKE=5
PROFIT_TARGET=20  # Telegram: /target off disables; /target 20 enables
MAX_SESSION_LOSS=5  # Telegram: /maxloss off disables; /maxloss 5 enables
SESSION_HOURS=24
MAX_TRADES_PER_SESSION=50
MAX_CONSECUTIVE_LOSSES=5
MARTINGALE_MAX_LEVELS=3
MARTINGALE_MULTIPLIER=2
ASSETS=EUR/USD:frxEURUSD,EUR/CHF:frxEURCHF,GBP/USD:frxGBPUSD,USD/JPY:frxUSDJPY,AUD/USD:frxAUDUSD,USD/CAD:frxUSDCAD
TIMEZONE=Africa/Lagos
